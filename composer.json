{
  "name": "mertaydin/laravel-system-monitor",
  "description": "A customizable Laravel system monitoring dashboard for server resources, PHP, database, cache, queue and application health.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.0",
    "laravel/pint": "^1.0",
    "larastan/larastan": "^2.9 || ^3.0",
    "barryvdh/laravel-ide-helper": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "MertAydin\\SystemMonitor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MertAydin\\SystemMonitor\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "MertAydin\\SystemMonitor\\SystemMonitorServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "format": "pint --test",
    "analyse": "phpstan analyse --no-progress",
    "pint-test": "pint --test"
  },
  "config": {
    "sort-packages": true,
    "preferred-install": {
      "phpstan/phpstan": "source",
      "*": "dist"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "homepage": "https://github.com/mertaydin/laravel-system-monitor",
  "support": {
    "issues": "https://github.com/mertaydin/laravel-system-monitor/issues",
    "source": "https://github.com/mertaydin/laravel-system-monitor"
  },
  "keywords": [
    "laravel",
    "system-monitor",
    "monitoring",
    "health-check",
    "server",
    "dashboard"
  ]
}
